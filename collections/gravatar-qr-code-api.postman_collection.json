          "id": "9232432f-fe0d-42a0-a52e-90fc35b3f1f4",
          "name": "Get QR code for an email address' profile",
          "request": {
            "name": "Get QR code for an email address' profile",
            "description": {
              "content": "Returns a QR code for an email address by the given SHA256 hash.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "qr-code",
                ":sha256_hash"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<integer>",
                  "description": "The size of the QR code."
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "The version of the QR code."
                },
                {
                  "disabled": false,
                  "key": "utm_medium",
                  "value": "<string>",
                  "description": "The medium of the UTM parameters. Appended to the URL in the QR code."
                },
                {
                  "disabled": false,
                  "key": "utm_campaign",
                  "value": "<string>",
                  "description": "The campaign of the UTM parameters. Appended to the URL in the QR code."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "The type of center icon to display ('user' for avatar, 'gravatar' for logo, 'none' for no icon)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "sha256_hash",
                  "description": "(Required) The SHA256 hash of the email address or profile URL slug."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
            "auth": null
